# Copy this to  ~/.supermemory/env  inside WSL, then fill in your own key.
#
#   cp env.example ~/.supermemory/env
#   chmod 600 ~/.supermemory/env
#
# Supermemory needs one LLM to pull facts out of text. Any OpenAI-compatible
# endpoint works. Change the three OPENAI_* lines to switch provider or model.

OPENAI_BASE_URL=https://your-provider.example.com/v1
OPENAI_API_KEY=PUT_YOUR_KEY_HERE
OPENAI_MODEL=your-model-name

# Where memories are stored. Keep this absolute so the server does not depend
# on which folder you launch it from. Replace <user> with your WSL username.
SUPERMEMORY_DATA_DIR=/home/<user>/.supermemory/data
